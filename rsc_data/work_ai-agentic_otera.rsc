49:["$","figure","13",{"className":"flex flex-col gap-3 mx-auto w-full max-w-[560px]","children":[["$","$L42",null,{"src":"/work/otera/usability-sus.webp","alt":"A System Usability Scale questionnaire with scored answers","sizes":"560px","ratio":1.1759259259259258,"fit":"contain","className":"$undefined"}],null]}]
4a:["$","div","14",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"SUS"}],null,[["$","p","Within the discovery phase, we conducted SUS (System Usability Scale) assessments by presenting users with interactive prototypes. This allowed us to gauge their ease of use, identify pain points, and gather actionable feedback to refine the design and enhance overall usability.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Within the discovery phase, we conducted SUS (System Usability Scale) assessments by presenting users with interactive prototypes. This allowed us to gauge their ease of use, identify pain points, and gather actionable feedback to refine the design and enhance overall usability."}]]]}]
4b:["$","$L42",null,{"src":"/work/otera/customer-calls.webp","alt":"Notes from customer calls and the interview question guide","sizes":"(min-width: 1280px) 1118px, 100vw","ratio":0.9316770186335404,"fit":"contain","className":"$undefined"}]
4c:["$","div","3",{"className":"relative overflow-clip rounded-[24px] bg-neutral-950","style":{"aspectRatio":1.7777777777777777},"children":["$","$L3d",null,{"name":"otera-affinity-map","label":"Affinity map of the HITL research: 56 interview insights sorted into four themes"}]}]
4d:["$","div","4",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"What we learned"}],null,[["$","p","Users don't distrust the model's accuracy so much as they distrust having no say in it. Across 12 interviews and behavioral analysis, the same theme surfaced from different angles: the system asked people to accept outputs they couldn't inspect, correct, or improve.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Users don't distrust the model's accuracy so much as they distrust having no say in it. Across 12 interviews and behavioral analysis, the same theme surfaced from different angles: the system asked people to accept outputs they couldn't inspect, correct, or improve."}]]]}]
4e:["$","div","5",{"className":"flex flex-col gap-8","children":[null,["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2 lg:grid-cols-4","children":[["$","li","No way to verify.",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"No way to verify."}],["$","p",null,{"className":"text-sm","children":"Users felt uneasy relying entirely on the system with no mechanism to review or validate what it produced."}]]}],["$","li","Errors were frequent and invisible.",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"Errors were frequent and invisible."}],["$","p",null,{"className":"text-sm","children":"75% reported recurring inaccuracies, especially in complex and edge-case documents — and with no error indicators or confidence signals, they couldn't tell which outputs needed a second look. The result was blanket manual rework."}]]}],["$","li","Corrections went nowhere.",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"Corrections went nowhere."}],["$","p",null,{"className":"text-sm","children":"Fixing the same mistake repeatedly, with no path to feed corrections back into the model, left participants feeling disempowered."}]]}],["$","li","The data model didn't match the work.",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"The data model didn't match the work."}],["$","p",null,{"className":"text-sm","children":"Users needed to process line items and line hierarchies, not just flat fields."}]]}]]}]]}]
4f:["$","div","6",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Goal"}],["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"Enable users to easily review, adjust, and approve model output."}],[["$","p","Put the human back in the loop: give users a way to review, correct, and teach the system — without needing technical expertise.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Put the human back in the loop: give users a way to review, correct, and teach the system — without needing technical expertise."}],["$","p","Specifically, design an interface that surfaces model confidence and flags likely errors so review effort goes where it's needed, lets users adjust pre-processing labels and define desired output directly, supports line-item and hierarchical extraction, and turns every manual correction into a signal that improves future performance.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Specifically, design an interface that surfaces model confidence and flags likely errors so review effort goes where it's needed, lets users adjust pre-processing labels and define desired output directly, supports line-item and hierarchical extraction, and turns every manual correction into a signal that improves future performance."}]]]}]
50:["$","div","1",{"className":"flex flex-col gap-8","children":[null,["$","div",null,{"className":"group/photos grid gap-6 md:grid-cols-2","children":[["$","$L42","/work/otera/hitl-review.webp",{"src":"/work/otera/hitl-review.webp","alt":"Split-screen review: the source invoice beside extracted fields with confidence scores","sizes":"(min-width: 768px) 547px, 100vw","ratio":1.3057671381936888,"fit":"contain","className":"$undefined"}],["$","$L42","/work/otera/hitl-labels.webp",{"src":"/work/otera/hitl-labels.webp","alt":"Label configuration table with types, parents, formats and frequency","sizes":"(min-width: 768px) 547px, 100vw","ratio":1.3057671381936888,"fit":"contain","className":"$undefined"}]]}]]}]
