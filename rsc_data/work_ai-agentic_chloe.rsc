x-[25px] py-8 leading-[22px]","children":[["$","dt",null,{"className":"text-base font-medium text-muted-foreground","children":"Team size"}],["$","dd",null,{"className":"text-sm","children":"1 PD, 1 PM"}]]}],["$","div","Timeline",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col justify-end gap-2 px-[25px] py-8 leading-[22px]","children":[["$","dt",null,{"className":"text-base font-medium text-muted-foreground","children":"Timeline"}],["$","dd",null,{"className":"text-sm","children":"2026"}]]}],["$","div","Platform",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col justify-end gap-2 px-[25px] py-8 leading-[22px]","children":[["$","dt",null,{"className":"text-base font-medium text-muted-foreground","children":"Platform"}],["$","dd",null,{"className":"text-sm","children":"Web and PWA"}]]}]]}]]}]]}]
33:["$","section","context",{"id":"context","aria-labelledby":"context-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"context-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Context"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,null,[["$","p","NexScale was at an inflection point. Despite operating at the intersection of AI and boutique fitness, the team was struggling to carve out a clear category within the emerging agentic operations space, one where gym studios and recreation centers could see themselves reflected. The market was noisy, and the product vision kept drifting between tool and platform, between assistant and automation. It wasn't until findings from an automation agency engagement surfaced a sharper truth: studio operators didn't want another dashboard to manage. They wanted someone to handle the work. That insight reframed everything. NexScale wasn't building software for fitness businesses, it was building the first AI operator for them, a category that didn't yet have a name but had an unmistakable demand hiding in plain sight.",{"className":"text-lg leading-[27px] text-foreground/80","children":"NexScale was at an inflection point. Despite operating at the intersection of AI and boutique fitness, the team was struggling to carve out a clear category within the emerging agentic operations space, one where gym studios and recreation centers could see themselves reflected. The market was noisy, and the product vision kept drifting between tool and platform, between assistant and automation. It wasn't until findings from an automation agency engagement surfaced a sharper truth: studio operators didn't want another dashboard to manage. They wanted someone to handle the work. That insight reframed everything. NexScale wasn't building software for fitness businesses, it was building the first AI operator for them, a category that didn't yet have a name but had an unmistakable demand hiding in plain sight."}]]]}],["$","div","1",{"className":"flex flex-col gap-8","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Goal"}],["$","ul",null,{"children":[["$","li","To design and build an agentic retention platform for gym studios.",{"className":"border-b border-foreground/5 px-3 py-2.5 text-sm font-medium leading-5 last:border-b-0","children":"To design and build an agentic retention platform for gym studios."}],["$","li","Continuous Improvement: Provide a framework for ongoing enhancement of chatbot responses and user interaction.",{"className":"border-b border-foreground/5 px-3 py-2.5 text-sm font-medium leading-5 last:border-b-0","children":"Continuous Improvement: Provide a framework for ongoing enhancement of chatbot responses and user interaction."}]]}]]}],"$L3a","$L3b","$L3c"]}]]}]
34:["$","section","onboarding",{"id":"onboarding","aria-labelledby":"onboarding-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"onboarding-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Onboarding"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"Seven steps, and a live CRM at the end of them."}],[["$","p","Signup is not the hard part. Connecting somebody else's CRM is. The flow had to carry a non technical owner from a cold landing to an authenticated integration without ever leaving them unsure what happens next, so every step states what it needs, why it needs it, and what is left.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Signup is not the hard part. Connecting somebody else's CRM is. The flow had to carry a non technical owner from a cold landing to an authenticated integration without ever leaving them unsure what happens next, so every step states what it needs, why it needs it, and what is left."}],["$","p","After a consensus with engineering and product considering constraints, timeline and minimum lovable user path, we agreed upon a registration path.",{"className":"text-lg leading-[27px] text-foreground/80","children":"After a consensus with engineering and product considering constraints, timeline and minimum lovable user path, we agreed upon a registration path."}],["$","p","I designed the sequence for web and mobile in parallel rather than adapting one to the other, because the person who signs up at a desk is often not the person who finishes the setup between classes.",{"className":"text-lg leading-[27px] text-foreground/80","children":"I designed the sequence for web and mobile in parallel rather than adapting one to the other, because the person who signs up at a desk is often not the person who finishes the setup between classes."}]]]}],["$","figure","1",{"className":"flex flex-col gap-3 mx-auto w-full max-w-[560px]","children":[["$","$L39",null,{"src":"/work/chloe/onboarding-path.webp","alt":"The agreed registration path as a flow chart, from sign up to a connected CRM","sizes":"560px","ratio":0.6113870844478411,"fit":"contain","className":"$undefined"}],null]}],["$","div","2",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"One flow, two canvases"}],null,[["$","p","Desktop and mobile were mapped as separate boards under the same step headers, so engineering could read a step across both widths without hunting.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Desktop and mobile were mapped as separate boards under the same step headers, so engineering could read a step across both widths without hunting."}]]]}],"$L3d","$L3e","$L3f","$L40"]}]]}]
35:["$","section","dashboard",{"id":"dashboard","aria-labelledby":"dashboard-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"dashboard-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Dashboard"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"A read on the business in the time it takes to drink a coffee."}],[["$","p","Operators do not sit with analytics. They check between classes. So the dashboard opens on what needs attention today and only then offers the depth: a monthly executive summary, member health, and how the room actually feels.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Operators do not sit with analytics. They check between classes. So the dashboard opens on what needs attention today and only then offers the depth: a monthly executive summary, member health, and how the room actually feels."}],["$","p","Every view keeps an Ask Chloe entry point in reach, so a number is never a dead end. All figures shown here are sample data.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Every view keeps an Ask Chloe entry point in reach, so a number is never a dead end. All figures shown here are sample data."}]]]}],["$","div","1",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Conversation"}],["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"The blank field is the hardest screen in the product."}],[["$","p","An open prompt tells a studio owner nothing about what the thing can do. The home state answers that with real questions from their own week, scoped by channel and by time, so the first message is never a guess.",{"className":"text-lg leading-[27px] text-foreground/80","children":"An open prompt tells a studio owner nothing about what the thing can do. The home state answers that with real questions from their own week, scoped by channel and by time, so the first message is never a guess."}],["$","p","Long analysis gets a visible working state and returns as a document rather than a wall of chat, since that is what gets acted on and shared.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Long analysis gets a visible working state and returns as a document rather than a wall of chat, since that is what gets acted on and shared."}]]]}],["$","div","2",{"className":"flex flex-col gap-8","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Ask Chloe"}],["$","ul",null,{"children":["$L41","$L42","$L43","$L44"]}]]}],"$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d"]}]]}]
36:["$","section","craft",{"id":"craft","aria-labelledby":"craft-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"craft-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Craft"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Words as design material"}],null,[["$","p","I wrote the interface copy alongside the layouts: error and validation messages, verification and activation emails, empty states, toasts, and the daily brief voice. The rule was plain verbs and one job per line. An empty inbox says you are all caught up and then says what will happen next, because an owner reading it at 6am wants to know whether to worry.",{"className":"text-lg leading-[27px] text-foreground/80","children":"I wrote the interface copy alongside the layouts: error and validation messages, verification and activation emails, empty states, toasts, and the daily brief voice. The rule was plain verbs and one job per line. An empty inbox says you are all caught up and then says what will happen next, because an owner reading it at 6am wants to know whether to worry."}]]]}],["$","div","1",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Design system"}],null,[["$","p","Most of what slowed us down wasn't taste, it was systems debt. Percent signs missing on one row, trends carried to two decimals, nav that shifted between screens. That's what happens when screens get built one at a time. A real table component, a badge with fixed variants, and one type scale close all of that off at the source.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Most of what slowed us down wasn't taste, it was systems debt. Percent signs missing on one row, trends carried to two decimals, nav that shifted between screens. That's what happens when screens get built one at a time. A real table component, a badge with fixed variants, and one type scale close all of that off at the source."}],["$","p","I'm keeping table, sorting, and row actions distinct from the start, because that's where data heavy screens usually get muddy. Two things I'm watching.",{"className":"text-lg leading-[27px] text-foreground/80","children":"I'm keeping table, sorting, and row actions distinct from the start, because that's where data heavy screens usually get muddy. Two things I'm watching."}],["$","p","Untitled is a generic SaaS kit, so the parts that make Chloe feel like Chloe (the insight panel, Today's Focus, sentiment rows, chat recommendations) stay ours to design on top. And I'm mapping tokens first, not last. Chloe's purple, the status colors, the lavender panel background all land in Untitled's semantic slots before anything gets built. I also need to pick one source of truth for tokens, Figma or the shadcn work, or we'll be maintaining two definitions of the same purple.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Untitled is a generic SaaS kit, so the parts that make Chloe feel like Chloe (the insight panel, Today's Focus, sentiment rows, chat recommendations) stay ours to design on top. And I'm mapping tokens first, not last. Chloe's purple, the status colors, the lavender panel background all land in Untitled's semantic slots before anything gets built. I also need to pick one source of truth for tokens, Figma or the shadcn work, or we'll be maintaining two definitions of the same purple."}],"$L4e"]]}],"$L4f"]}]]}]
