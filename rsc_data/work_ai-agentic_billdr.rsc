34:["$","section","problem",{"id":"problem","aria-labelledby":"problem-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"problem-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Problem"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,null,[["$","p","Construction projects generate chaos, not just buildings. Teams contend with scattered communication (texts, chats, word-of-mouth), heavy manual admin after long shifts, no real-time visibility into schedules, and delayed logs and expense reports—making accurate tracking and coordination nearly impossible.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Construction projects generate chaos, not just buildings. Teams contend with scattered communication (texts, chats, word-of-mouth), heavy manual admin after long shifts, no real-time visibility into schedules, and delayed logs and expense reports—making accurate tracking and coordination nearly impossible."}],["$","p","The existing PWA dashboard offered limited capability, and its weak hierarchy and dense layouts made task management and shift management difficult to interpret in everyday use.",{"className":"text-lg leading-[27px] text-foreground/80","children":"The existing PWA dashboard offered limited capability, and its weak hierarchy and dense layouts made task management and shift management difficult to interpret in everyday use."}]]]}],["$","figure","1",{"className":"flex flex-col gap-3","children":[["$","$L3b",null,{"src":"/work/billdr/problem.webp","alt":"The existing Billdr PWA dashboard on a laptop and a phone","sizes":"(min-width: 1280px) 1118px, 100vw","ratio":1.7139240506329114,"fit":"contain","className":"$undefined"}],null]}]]}]]}]
35:["$","section","research",{"id":"research","aria-labelledby":"research-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"research-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Research"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"Looking beyond speculations"}],[["$","p","To better understand where friction appeared across the dashboard, I reviewed current workflows and conducted user interviews with people regularly managing projects and in-field workers. The research focused on how users scanned information, created tasks and shifts, and navigated everyday tasks across the interface.",{"className":"text-lg leading-[27px] text-foreground/80","children":"To better understand where friction appeared across the dashboard, I reviewed current workflows and conducted user interviews with people regularly managing projects and in-field workers. The research focused on how users scanned information, created tasks and shifts, and navigated everyday tasks across the interface."}]]]}],["$","div","1",{"className":"relative overflow-clip rounded-[24px] bg-neutral-950","style":{"aspectRatio":1.7777777777777777},"children":["$","$L3c",null,{"name":"billdr-affinity-map","label":"Interview insights grouped into clusters on an affinity map"}]}],["$","div","2",{"className":"flex flex-col gap-4","children":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"What we learned"}],null,[["$","p","Designing for deskless and frontline workers is fundamentally different from designing for office based users. The context of use changes everything, people are on the go, often on active job sites, glancing at their phone between tasks rather than sitting at a desk.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Designing for deskless and frontline workers is fundamentally different from designing for office based users. The context of use changes everything, people are on the go, often on active job sites, glancing at their phone between tasks rather than sitting at a desk."}],["$","p","Through interviews and workflow analysis, I identified recurring patterns in how users reviewed tasks, tracked shifts, and navigated everyday tasks. The biggest issue wasn’t complexity itself, it was uncertainty. Users often stopped to clock-in shifts, reopen shift and tasks details, or rescan multiple sections before taking action. Similar visual weight across the interface made it difficult to quickly identify what mattered most.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Through interviews and workflow analysis, I identified recurring patterns in how users reviewed tasks, tracked shifts, and navigated everyday tasks. The biggest issue wasn’t complexity itself, it was uncertainty. Users often stopped to clock-in shifts, reopen shift and tasks details, or rescan multiple sections before taking action. Similar visual weight across the interface made it difficult to quickly identify what mattered most."}],"$L3d","$L3e"]]}]]}]]}]
36:["$","section","ideation",{"id":"ideation","aria-labelledby":"ideation-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"ideation-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Ideation"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"Exploring directions"}],[["$","p","With a clearer picture of how General Contractors and their crews actually move through a job site, ideation focused on turning research insights into concrete directions. The goal wasn’t to add features — it was to reduce uncertainty and make the most common actions obvious at a glance.",{"className":"text-lg leading-[27px] text-foreground/80","children":"With a clearer picture of how General Contractors and their crews actually move through a job site, ideation focused on turning research insights into concrete directions. The goal wasn’t to add features — it was to reduce uncertainty and make the most common actions obvious at a glance."}],["$","p","I sketched a range of layouts for the dashboard, task, and shift flows, exploring how to establish a stronger visual hierarchy so that priority tasks, active shifts, and next steps stood apart from secondary details. Early concepts pushed toward a glanceable, mobile-first structure — large touch targets, one-handed reach, and shift actions like clock-in surfaced directly instead of buried in nested screens.",{"className":"text-lg leading-[27px] text-foreground/80","children":"I sketched a range of layouts for the dashboard, task, and shift flows, exploring how to establish a stronger visual hierarchy so that priority tasks, active shifts, and next steps stood apart from secondary details. Early concepts pushed toward a glanceable, mobile-first structure — large touch targets, one-handed reach, and shift actions like clock-in surfaced directly instead of buried in nested screens."}],["$","p","Rather than committing to a single idea, I mapped several competing directions against real on-site constraints: noisy environments, quick context switches, and the need to complete tasks without confusion. Testing these low-fidelity concepts on actual devices helped me narrow down to the patterns that felt fastest and most intuitive in the field, and those became the foundation for the design decisions that followed.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Rather than committing to a single idea, I mapped several competing directions against real on-site constraints: noisy environments, quick context switches, and the need to complete tasks without confusion. Testing these low-fidelity concepts on actual devices helped me narrow down to the patterns that felt fastest and most intuitive in the field, and those became the foundation for the design decisions that followed."}]]]}],"$L3f","$L40"]}]]}]
37:["$","section","designs",{"id":"designs","aria-labelledby":"designs-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"designs-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Design"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,["$","p",null,{"className":"text-2xl leading-9 text-muted-foreground","children":"Design system and prototyping"}],[["$","p","Billdr had no existing design system in place, and with a mobile app on the horizon, we needed a foundation that could scale to web without starting over. After thorough research and several rounds of cross-functional discussion, we aligned on a cross-platform strategy, adopting React Native Reusables as our component foundation and anchoring the system to shadcn/ui, adapting its primitives to fit our specific product requirements. This gave us a scalable, consistent token architecture that bridged mobile and web without maintaining two separate systems.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Billdr had no existing design system in place, and with a mobile app on the horizon, we needed a foundation that could scale to web without starting over. After thorough research and several rounds of cross-functional discussion, we aligned on a cross-platform strategy, adopting React Native Reusables as our component foundation and anchoring the system to shadcn/ui, adapting its primitives to fit our specific product requirements. This gave us a scalable, consistent token architecture that bridged mobile and web without maintaining two separate systems."}]]]}],["$","figure","1",{"className":"flex flex-col gap-3","children":[["$","$L3b",null,{"src":"/work/billdr/design-system.webp","alt":"The design system's settings components in light and dark themes","sizes":"(min-width: 1280px) 1118px, 100vw","ratio":1.3333333333333333,"fit":"contain","className":"$undefined"}],null]}],["$","div","2",{"className":"flex flex-col gap-4","children":[null,null,[["$","p","Trio ideation gave us the space to ask \"what if\" before asking \"what's feasible.\" Freed from technical and scope constraints, the most compelling concept that surfaced was a voice agentic flow where workers could dictate tasks on the go rather than navigating a form. For a construction workforce that's often hands-on and time-pressured on site, this wasn't just a novel idea; it was the most human-centered solution in the room.",{"className":"text-lg leading-[27px] text-foreground/80","children":"Trio ideation gave us the space to ask \"what if\" before asking \"what's feasible.\" Freed from technical and scope constraints, the most compelling concept that surfaced was a voice agentic flow where workers could dictate tasks on the go rather than navigating a form. For a construction workforce that's often hands-on and time-pressured on site, this wasn't just a novel idea; it was the most human-centered solution in the room."}]]]}],"$L41","$L42","$L43"]}]]}]
38:["$","section","lessons",{"id":"lessons","aria-labelledby":"lessons-title","children":[["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5","children":[["$","div",null,{"aria-hidden":true,"className":"pointer-events-none relative h-px","children":[["$","div",null,{"className":"absolute -inset-x-[129px] top-0 h-px bg-foreground/5"}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background left-0 -translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}],["$","span",null,{"className":"absolute top-0 grid size-5 -translate-y-1/2 place-items-center rounded-full bg-background right-0 translate-x-1/2","children":["$","span",null,{"className":"size-0.5 rounded-full bg-foreground"}]}]]}],["$","div",null,{"className":"px-6 pb-10 pt-24 md:px-12 lg:pt-40","children":["$","h2",null,{"id":"lessons-title","className":"text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]","children":"Lessons"}]}]]}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] border-x border-foreground/5 flex flex-col gap-12 px-6 pb-24 pt-12 md:px-[41px]","children":[["$","div","0",{"className":"flex flex-col gap-4","children":[null,null,[["$","p","The product is still in active development, but early prototype showcases with a select group of customers and real users have already validated the direction. The feedback has been consistently positive, what stood out most was how quickly people could get to what they needed, with minimal friction and no hand-holding. For a workforce that isn't always comfortable with digital tools, that ease of reaching the goal was exactly what we designed for and hearing it reflected back from real users made it clear the approach was right.",{"className":"text-lg leading-[27px] text-foreground/80","children":"The product is still in active development, but early prototype showcases with a select group of customers and real users have already validated the direction. The feedback has been consistently positive, what stood out most was how quickly people could get to what they needed, with minimal friction and no hand-holding. For a workforce that isn't always comfortable with digital tools, that ease of reaching the goal was exactly what we designed for and hearing it reflected back from real users made it clear the approach was right."}]]]}],["$","figure","1",{"className":"flex flex-col gap-3","children":[["$","$L3b",null,{"src":"/work/billdr/at-a-glance.webp","alt":"The Billdr worker app at a glance: shifts, tasks and projects on three phones","sizes":"(min-width: 1280px) 1118px, 100vw","ratio":1.3333333333333333,"fit":"contain","className":"$undefined"}],null]}]]}]]}]
