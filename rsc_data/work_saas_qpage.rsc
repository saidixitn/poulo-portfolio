":[["$","h3",null,{"className":"text-[28px] font-medium leading-8 text-foreground/80","children":"Discovery process"}],["$","ul",null,{"className":"grid gap-3 sm:grid-cols-2 lg:grid-cols-4","children":[["$","li","Method",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"Method"}],["$","p",null,{"className":"text-sm","children":"Design thinking. Rapid prototyping. Qualitative research."}]]}],["$","li","Interviews",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"Interviews"}],["$","p",null,{"className":"text-sm","children":"Conducted interviews with 15 frequent users to uncover problems, pains and opportunities."}]]}],["$","li","User behavior",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"User behavior"}],["$","p",null,{"className":"text-sm","children":"Analyzed user behavior to identify bottlenecks in the current flow."}]]}],["$","li","Competitors",{"className":"rounded-[24px] border border-border/50 bg-secondary flex flex-col gap-2 px-[25px] py-[39px] leading-[22px]","children":[["$","h4",null,{"className":"text-base font-medium text-muted-foreground","children":"Competitors"}],["$","p",null,{"className":"text-sm","children":"Researched competitors and best practices."}]]}]]}]]}],["$","div","2",{"className":"relative overflow-clip rounded-[24px] bg-neutral-950","style":{"aspectRatio":1.7777777777777777},"children":["$","$L45",null,{"name":"qpage-affinity-map","label":"Interview insights grouped into clusters on an affinity map"}]}],"$L46","$L47","$L48","$L49",