focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background h-6 w-12 items-center"><span data-slot="preview-rail-tick" aria-hidden="true" class="block bg-current h-0.5 w-12 origin-left"></span></a><a data-slot="preview-rail-item" href="#ideation" aria-label="Ideation" style="height:24px" class="relative flex text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background h-6 w-12 items-center"><span data-slot="preview-rail-tick" aria-hidden="true" class="block bg-current h-0.5 w-12 origin-left"></span></a><a data-slot="preview-rail-item" href="#designs" aria-label="Design" style="height:24px" class="relative flex text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background h-6 w-12 items-center"><span data-slot="preview-rail-tick" aria-hidden="true" class="block bg-current h-0.5 w-12 origin-left"></span></a><a data-slot="preview-rail-item" href="#lessons" aria-label="Lessons" style="height:24px" class="relative flex text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background h-6 w-12 items-center"><span data-slot="preview-rail-tick" aria-hidden="true" class="block bg-current h-0.5 w-12 origin-left"></span></a></nav><div aria-hidden="true" style="grid-template-rows:repeat(5, 24px)" class="pointer-events-none absolute z-50 grid inset-y-0 right-4 left-16 content-center"><div style="height:24px" class="relative flex items-center"></div><div style="height:24px" class="relative flex items-center"></div><div style="height:24px" class="relative flex items-center"></div><div style="height:24px" class="relative flex items-center"></div><div style="height:24px" class="relative flex items-center"></div></div></div><div class="mx-auto w-full max-w-[1200px] border-x border-foreground/5"><header class="px-6 pb-10 pt-16 md:px-12 lg:pt-24"><a class="inline-flex h-11 items-center gap-2 rounded-md text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring" href="/#work"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left size-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>All work</a><p class="mt-10 text-2xl leading-[44.8px] text-muted-foreground">Billdr AI</p><h1 class="text-2xl font-medium leading-8 md:text-[32px] md:leading-[42px]"><span class="inline whitespace-normal"><span class="sr-only">Billdr AI. Redesigning how crews run their day on site. </span><span aria-hidden="true">Billdr AI. Redesigning how crews run their day on site.</span></span></h1><ul class="flex gap-2 text-xs leading-[42px] text-foreground/40"><li>#AIandAgentics</li><li>#MobileApp</li></ul><nav aria-label="Sections" class="mt-6 flex flex-wrap gap-2 md:gap-4"><a href="#problem" class="inline-flex h-11 items-center justify-center rounded-full bg-background px-5 text-base text-foreground outline-none transition-colors hover:bg-secondary shadow-[0_0_0.5px_rgb(0_0_0/0.4),0_1px_0.5px_rgb(0_0_0/0.04),0_2px_2px_rgb(0_0_0/0.04)] dark:ring-1 dark:ring-white/15 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background">Problem</a><a href="#research" class="inline-flex h-11 items-center justify-center rounded-full bg-background px-5 text-base text-foreground outline-none transition-colors hover:bg-secondary shadow-[0_0_0.5px_rgb(0_0_0/0.4),0_1px_0.5px_rgb(0_0_0/0.04),0_2px_2px_rgb(0_0_0/0.04)] dark:ring-1 dark:ring-white/15 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-