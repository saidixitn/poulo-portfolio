next_f.push([1,"3e:[\"$\",\"p\",\"The triage and discovery phase was critical here. I spent time understanding how GCs and their teams actually move through their day on site, what information they need at a glance versus what can be secondary, and where the existing process created friction. That shaped the information architecture and interaction model from the ground up.\",{\"className\":\"text-lg leading-[27px] text-foreground/80\",\"children\":\"The triage and discovery phase was critical here. I spent time understanding how GCs and their teams actually move through their day on site, what information they need at a glance versus what can be secondary, and where the existing process created friction. That shaped the information architecture and interaction model from the ground up.\"}]\n"])</script><script>self.__next_f.push([1,"3f:[\"$\",\"figure\",\"1\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"$L3b\",null,{\"src\":\"/work/billdr/home-variations.webp\",\"alt\":\"Billdr home page screen variations as low-fidelity wireframes\",\"sizes\":\"(min-width: 1280px) 1118px, 100vw\",\"ratio\":2.169651272384543,\"fit\":\"contain\",\"className\":\"$undefined\"}],null]}]\n40:[\"$\",\"figure\",\"2\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"$L3b\",null,{\"src\":\"/work/billdr/wireframes.webp\",\"alt\":\"Wireframe flow connecting the app's screens from sign in to a voice task\",\"sizes\":\"(min-width: 1280px) 1118px, 100vw\",\"ratio\":1.7297297297297298,\"fit\":\"contain\",\"className\":\"$undefined\"}],null]}]\n41:[\"$\",\"div\",\"3\",{\"className\":\"relative overflow-clip rounded-[24px] bg-neutral-950\",\"style\":{\"aspectRatio\":1.7777777777777777},\"children\":[\"$\",\"$L3c\",null,{\"name\":\"billdr-voice\",\"label\":\"Billdr Voice: creating, reviewing and updating tasks by voice\"}]}]\n"])</script><script>self.__next_f.push([1,"42:[\"$\",\"div\",\"4\",{\"className\":\"flex flex-col gap-4\",\"children\":[null,null,[[\"$\",\"p\",\"